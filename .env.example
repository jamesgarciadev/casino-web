# Server-only. The browser never talks to the API directly; it goes through /api/graphql.
CASINO_API_URL=http://localhost:8000/graphql

# Reverb websocket for live match updates (same values as casino-be's REVERB_*). Set before `next build`.
REVERB_APP_KEY=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
